# Setup your files
my_image = "70deg_bentat90.tif"              # Update this if your file name changes!
my_coin_diameter = 23.25                   # 23.25mm is a standard 1 Euro Coin
database_name = "4D_Print_Data_Final.csv"  # The name of your spreadsheet

