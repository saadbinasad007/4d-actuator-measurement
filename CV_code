conversion_factor, coin_mask = get_coin_calibration_and_mask(my_image, reference_diameter_mm=my_coin_diameter)

if conversion_factor is not None and coin_mask is not None:
    print("\n>> STEP 2: Erasing coin and analyzing bent bar...")
    radius, angle = analyze_bent_bar_with_mask(my_image, conversion_factor, coin_mask)

    if radius is not None:
        print(f"\n>>> MEASUREMENTS COMPLETE -> Radius: {radius:.2f}mm | Angle: {angle:.2f}deg")

        # >> STEP 3: Trigger the prompts and save to the database!
        export_to_csv(database_name, my_image, radius, angle)
